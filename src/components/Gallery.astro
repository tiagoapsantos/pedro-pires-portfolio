---
import ArtworkCard from './ArtworkCard.astro';
import { artworks, availableCategories, featuredArtworks, heroArtwork } from '../data/artworks';
import { t } from '../data/site';
import type { Locale } from '../data/site';
const { locale, featured = false, spotlight = false } = Astro.props as { locale: Locale; featured?: boolean; spotlight?: boolean };
const viewerId = spotlight ? 'spotlight' : featured ? 'featured' : 'portfolio';
const items = spotlight ? [heroArtwork] : featured ? featuredArtworks : artworks;
---
<section class:list={['gallery', featured && 'gallery-featured', spotlight && 'gallery-spotlight']} data-gallery data-locale={locale} data-base={import.meta.env.BASE_URL} aria-label={t(locale, 'Galeria de ilustrações', 'Illustration gallery')}>
{!featured && !spotlight && <div class="filter-bar"><div class="filter-list" role="group" aria-label={t(locale, 'Filtrar por categoria', 'Filter by category')}><button class="filter-button" type="button" data-filter="all" aria-pressed="true">{t(locale, 'Todas', 'All')}</button>{availableCategories(items).map(category => <button class="filter-button" type="button" data-filter={category.id} aria-pressed="false">{category[locale]}</button>)}</div><p class="sr-only" data-count role="status" aria-live="polite">{items.length} {t(locale, 'imagens', 'images')}</p></div>}
<div class="gallery-grid">{items.map((item, index) => <ArtworkCard item={item} index={index} locale={locale} priority={spotlight} sizes={spotlight ? "(max-width:600px) 100vw, 50vw" : featured ? "(max-width:600px) 100vw, 60vw" : "(max-width:600px) 100vw, 50vw"}/>)}</div><p class="empty-state" data-empty hidden>{t(locale, 'Ainda não há imagens identificadas nesta categoria. Escolha Todas para consultar a selecção disponível.', 'No images have been identified in this category yet. Choose All to browse the available selection.')}</p><noscript><p class="content-note">{t(locale, 'Todas as imagens permanecem visíveis. A filtragem e ampliação precisam de JavaScript.', 'All images remain visible. Filtering and enlargement require JavaScript.')}</p></noscript>
<script type="application/json" data-artworks set:html={JSON.stringify(items).replace(/</g, '\u003c')}/>
<dialog class="artwork-dialog" aria-labelledby={viewerId + '-title'} aria-describedby={viewerId + '-description'} data-viewer><div class="viewer-top"><span class="sr-only" data-viewer-count></span><button class="close-button" type="button" data-close aria-label={t(locale, 'Fechar visualização ampliada', 'Close enlarged view')}>{t(locale, 'Fechar', 'Close')} <span aria-hidden="true">×</span></button></div><div class="viewer-layout"><button class="viewer-arrow" type="button" data-previous aria-label={t(locale, 'Ilustração anterior', 'Previous illustration')}>←</button><div class="viewer-media" data-media></div><button class="viewer-arrow" type="button" data-next aria-label={t(locale, 'Ilustração seguinte', 'Next illustration')}>→</button></div><div class="sr-only" aria-live="polite"><h2 id={viewerId + '-title'} data-viewer-title></h2><p id={viewerId + '-description'} data-viewer-description class="sr-only"></p><p class="sr-only" data-viewer-credit></p></div><p class="sr-only">{t(locale, '← → para navegar · Esc para fechar', '← → to navigate · Esc to close')}</p></dialog>
</section>
<script src="../scripts/gallery.ts"></script>
