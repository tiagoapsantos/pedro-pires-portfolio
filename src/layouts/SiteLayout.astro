---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { labels, t, href } from '../data/site';
import type { Locale, Page } from '../data/site';
import '../styles/global.css';
const { locale, page, description } = Astro.props as { locale: Locale; page: Page; description: string; is404?: boolean };
const is404 = Boolean(Astro.props.is404);
const canonical = new URL(href(locale, page, import.meta.env.BASE_URL), Astro.site).href;
const alternate = (language: Locale) => new URL(href(language, page, import.meta.env.BASE_URL), Astro.site).href;
const title = is404 ? '404 · Pedro Pires' : page === 'home' ? 'Pedro Pires — ' + t(locale, 'Ilustração e Design', 'Illustration and Design') : labels[locale][page] + ' · Pedro Pires';
---
<!doctype html><html lang={locale === 'pt' ? 'pt-PT' : 'en'}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><link rel="preload" href={import.meta.env.BASE_URL + 'fonts/bebas-neue-latin-400.woff2'} as="font" type="font/woff2" crossorigin="anonymous"/><link rel="preload" href={import.meta.env.BASE_URL + 'fonts/space-grotesk-latin-variable.woff2'} as="font" type="font/woff2" crossorigin="anonymous"/><title>{title}</title><meta name="description" content={description}/><meta name="theme-color" content="#101112"/><meta name="robots" content={is404 ? 'noindex, follow' : 'index, follow'}/>{!is404 && <><link rel="canonical" href={canonical}/><link rel="alternate" hreflang="pt-PT" href={alternate('pt')}/><link rel="alternate" hreflang="en" href={alternate('en')}/><link rel="alternate" hreflang="x-default" href={alternate('pt')}/><meta property="og:url" content={canonical}/><meta property="og:locale:alternate" content={locale === 'pt' ? 'en_GB' : 'pt_PT'}/></>}<meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:locale" content={locale === 'pt' ? 'pt_PT' : 'en_GB'}/><link rel="icon" type="image/svg+xml" href={import.meta.env.BASE_URL + 'favicon.svg'}/></head><body><a class="skip-link" href="#main">{t(locale, 'Saltar para o conteúdo', 'Skip to content')}</a><Header locale={locale} page={page}/><main id="main" tabindex="-1"><slot/></main><Footer locale={locale}/></body></html>
