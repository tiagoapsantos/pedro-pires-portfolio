---
import Gallery from '../components/Gallery.astro';
import { href, t, labels } from '../data/site';
import type { Locale } from '../data/site';
const { locale } = Astro.props as { locale: Locale };
const base = import.meta.env.BASE_URL;
---
<section class="home-hero wrap"><h1 class="home-opening">{t(locale, 'Entre o traço e a imaginação.', 'Between line and imagination.')}</h1><img class="home-main-image" src={base + 'images/home/panels-2048.webp'} srcset={base + 'images/home/panels-1024.webp 1024w, ' + base + 'images/home/panels-2048.webp 2048w'} sizes="(min-width:1640px) 1480px, 91vw" width="2048" height="1302" alt={t(locale, 'Composição de cinco painéis verticais com personagens ilustradas, sobre fundo preto.', 'Composition of five vertical panels with illustrated characters on a black background.')} loading="eager" fetchpriority="high" decoding="async"/></section>
<section class="work-section home-work wrap"><div class="section-heading"><h2>{t(locale, 'Selecção de ilustrações', 'Selected illustrations')}</h2><a class="arrow-link" href={href(locale, 'portfolio', base)}>{labels[locale].portfolio} <span aria-hidden="true">↗</span></a></div><Gallery locale={locale} featured/></section>
